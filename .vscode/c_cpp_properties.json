{
  "configurations": [
    {
      "name": "Linux ARM64",
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-arm64",
      "includePath": [
        "${workspaceFolder}/npc",
        "${workspaceFolder}/npc/csrc/include",
        "${workspaceFolder}/npc/obj_dir/**",
        "${workspaceFolder}/nvboard/include",
        "${workspaceFolder}/nvboard/usr/include",
        "${workspaceFolder}/abstract-machine/am/include",
        "${workspaceFolder}/abstract-machine/klib/include",
        "/usr/include/SDL2",
        "${env:YSYX_VERILATOR_INCLUDE}",
        "/usr/local/share/verilator/include",
        "/usr/local/share/verilator/include/vltstd"
      ]
    },
    {
      "name": "Linux x64",
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64",
      "includePath": [
        "${workspaceFolder}/npc",
        "${workspaceFolder}/npc/csrc/include",
        "${workspaceFolder}/npc/obj_dir/**",
        "${workspaceFolder}/nvboard/include",
        "${workspaceFolder}/nvboard/usr/include",
        "${workspaceFolder}/abstract-machine/am/include",
        "${workspaceFolder}/abstract-machine/klib/include",
        "/usr/include/SDL2",
        "${env:YSYX_VERILATOR_INCLUDE}",
        "/usr/local/share/verilator/include",
        "/usr/local/share/verilator/include/vltstd"
      ]
    }
  ],
  "version": 4
}
